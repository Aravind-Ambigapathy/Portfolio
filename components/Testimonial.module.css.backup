.testimonial {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
  border: 1px solid #ddd;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.testimonialImg {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  margin-bottom: 10px;
}

.testimonialText {
  margin-bottom: 10px;
}

.testimonialAuthor {
  margin-bottom: 10px;
}

.show-more {
  background-color: #4CAF50;
  color: #fff;
  padding: 10px 20px;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

.show-more:hover {
  background-color: #3e8e41;
}

.testimonials__container {
  max-height: 300px;
  overflow-y: auto;
}

.testimonials__container.show-more {
  max-height: 500px;
}